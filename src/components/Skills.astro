---
const skills = {
  languages: [
    { name: "JavaScript", icon: "devicon-javascript-plain colored" },
    { name: "TypeScript", icon: "devicon-typescript-plain colored" },
    { name: "Java", icon: "devicon-java-plain colored" },
    { name: "HTML5", icon: "devicon-html5-plain colored" },
    { name: "CSS3", icon: "devicon-css3-plain colored" },
    { name: "Node.js", icon: "devicon-nodejs-plain colored" },
  ],
  frameworks: [
    { name: "React", icon: "devicon-react-original colored" },
    { name: "Next.js", icon: "devicon-nextjs-plain colored" },
    { name: "Angular", icon: "devicon-angularjs-plain colored" },
    { name: "Spring Boot", icon: "devicon-spring-plain colored" },
  ],
  cloud: [
    { name: "AWS", icon: "devicon-amazonwebservices-plain-wordmark colored" },
    { name: "Salesforce", icon: "devicon-salesforce-plain colored" },
  ],
};

const aiSkills = [
  "Cursor · Kiro · Claude Code — prompt & spec engineering",
  "MCP server development & AI agent orchestration",
  "Enterprise AI steering systems & global context injection",
  "AI regression harness & automated workflow design",
];

const observabilitySkills = [
  "Grafana · New Relic — production monitoring & performance tuning",
  "HIPAA compliance · PII/PHI data handling",
  "Zero trust security · microservices architecture · CI/CD pipelines",
];
---

<section>
  <h2>Skills</h2>

  <h3>Programming Languages & Runtimes</h3>
  <div class="skills-grid">
    {
      skills.languages.map((tech) => (
        <div class="skill-item">
          <i class={`${tech.icon}`} />
          <span>{tech.name}</span>
        </div>
      ))
    }
  </div>

  <h3>Frameworks & Libraries</h3>
  <div class="skills-grid">
    {
      skills.frameworks.map((tech) => (
        <div class="skill-item">
          <i class={`${tech.icon}`} />
          <span>{tech.name}</span>
        </div>
      ))
    }
  </div>

  <h3>Cloud & Infrastructure</h3>
  <div class="skills-grid">
    {
      skills.cloud.map((tech) => (
        <div class="skill-item">
          <i class={`${tech.icon}`} />
          <span>{tech.name}</span>
        </div>
      ))
    }
  </div>

  <h3>Enterprise AI Tooling</h3>
  <ul class="text-skills">
    {aiSkills.map((skill) => <li>{skill}</li>)}
  </ul>

  <h3>Observability, Security & Compliance</h3>
  <ul class="text-skills">
    {observabilitySkills.map((skill) => <li>{skill}</li>)}
  </ul>
</section>

<style>
  .text-skills {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0.5rem 0 1.25rem;
    font-size: 0.9rem;
    color: #374151;
    line-height: 1.7;
  }
</style>
